{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Environment",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/check_environment.sh", "--check"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python3 scripts/submit.py --test-only",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Submit",
      "type": "shell",
      "command": "python3 scripts/submit.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Sync Course",
      "type": "shell",
      "command": "python3 scripts/sync_course.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Play",
      "type": "shell",
      "command": "python3 \"${file}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Open Interactive Slides",
      "type": "shell",
      "command": "python3 -m http.server 8000 --directory docs",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
